# --- Creditcoin CC3 testnet (chain id 102031) ---
CREDITCOIN_RPC_URL="https://rpc.cc3-testnet.creditcoin.network"
PROOF_BUILDER_URL="https://prover.cc3-testnet.creditcoin.network"

# Deploys the Convoy stack. Needs testnet CTC.
CREDITCOIN_PRIVATE_KEY=""

# Runs the relayer. Needs testnet CTC for the bond and for delivery gas.
# Keep this separate from the deployer key: the whole point is that relaying is a third party.
RELAYER_PRIVATE_KEY=""

# --- Ethereum Sepolia (source chain) ---
# chainKey is Creditcoin's internal id for the source chain. It is NOT the EVM chain id (11155111).
SOURCE_CHAIN_KEY=1
SOURCE_CHAIN_RPC_URL=""
SOURCE_PRIVATE_KEY=""

# --- Batching policy ---
# Precompile limits. Do not raise these; the precompile rejects anything larger.
MAX_BATCH_SIZE=10
MAX_BATCH_RANGE=1000
# How long a transaction may wait for companions before it ships alone. Raising this fills batches
# but risks the source block ageing out of the dense attestation window, which makes its continuity
# proof ~100x longer. See relayer/batcher.ts.
MAX_WAIT_MS=180000
POLL_INTERVAL_MS=12000
